<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Limbus Damage Calculator</title>
<style>
:root{--bg:#e4dccb;--paper:#f2ebdc;--ink:#1b1613;--mut:#6e6254;--line:#b9ab94;--acc:#b0242b;--gold:#8a6a12;--in:#fbf7ee;--ok:#2f6f3a;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b090a;--paper:#171213;--ink:#eee4d4;--mut:#a09384;--line:#3a2f31;--acc:#e0414a;--gold:#e2b64d;--in:#0f0c0d;--ok:#8fd16a;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0b090a;--paper:#171213;--ink:#eee4d4;--mut:#a09384;--line:#3a2f31;--acc:#e0414a;--gold:#e2b64d;--in:#0f0c0d;--ok:#8fd16a;color-scheme:dark}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:14px/1.45 "Bahnschrift","Segoe UI",Roboto,Arial,sans-serif;min-height:100%}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.09;background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
.wrap{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:0 16px 40px}
header{margin:0 -16px 16px;padding:18px 16px 14px;border-bottom:3px solid var(--ink);background:repeating-linear-gradient(135deg,transparent 0 9px,rgba(128,100,70,.12) 9px 10px);position:relative}
header::after{content:"";position:absolute;left:0;right:0;bottom:-3px;height:3px;background:linear-gradient(90deg,#fa6807,#f6c200,#94d400,#2e9fd8,#2a5de0,#8a3fc9,#e1302a)}
h1{margin:0;font:800 1.9rem/1 "Bahnschrift","Arial Narrow",Impact,sans-serif;letter-spacing:.08em;text-transform:uppercase}
h1 b{color:var(--acc)}
.tag{color:var(--mut);font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;margin-top:6px}
.hb{position:absolute;right:16px;top:16px;display:flex;gap:6px}
@media(max-width:640px){.hb{position:static;margin-top:10px}}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 440px;gap:16px;align-items:start}
@media(max-width:960px){.layout{grid-template-columns:1fr}}
.tabs{display:flex;gap:4px}
.tabs button{flex:1;padding:10px 6px;border:1px solid var(--line);border-bottom:0;background:var(--in);color:var(--mut);font:700 .85rem "Bahnschrift",Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,0 100%)}
.tabs button.on{background:var(--acc);color:#fff;border-color:var(--acc)}
.panel{display:none;background:var(--paper);border:1px solid var(--line);border-top:3px solid var(--acc);padding:14px 16px 16px;background-image:repeating-linear-gradient(0deg,transparent 0 23px,rgba(128,100,70,.07) 23px 24px)}
.panel.on{display:block}
.panel h2,.res h2{margin:0 0 8px;font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);border-bottom:1px dashed var(--line);padding-bottom:4px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:640px){.two{grid-template-columns:1fr}}
.f{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:6px 0}
.f span{font-size:.86rem}.f small{display:block;color:var(--mut);font-size:.7rem;line-height:1.2}
input[type=number],select{width:92px;padding:5px 7px;border:1px solid var(--line);border-left:3px solid var(--gold);background:var(--in);color:var(--ink);font:inherit;text-align:right}
select{width:130px}
.f.im{position:relative;isolation:isolate;min-height:56px;padding-left:4px}.f.im::before,.f.im::after{content:"";position:absolute;left:0;top:50%;width:54px;height:54px;transform:translateY(-50%);pointer-events:none}.f.im::before{background:var(--in);border:1px solid var(--line);border-radius:8px;z-index:-2}.f.im::after{background:center/78% no-repeat;opacity:.92;z-index:-1}.f.im>span{padding-left:64px}
.f.im-coin::after{background-image:url(data:image/png;base64,)}
.f.im-arm::after{background-image:url(data:image/png;base64,)}
.f.im-brain::after{background-image:url(data:image/png;base64,)}
.tot b{display:inline-block}
@keyframes pop{0%{transform:scale(1)}40%{transform:scale(1.07)}100%{transform:scale(1)}}
@keyframes shake{0%,100%{transform:translateX(0) rotate(0)}20%{transform:translateX(-3px) rotate(-8deg)}40%{transform:translateX(3px) rotate(8deg)}60%{transform:translateX(-2px) rotate(-4deg)}80%{transform:translateX(2px) rotate(4deg)}}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.anim .pop{animation:pop .28s ease}
.anim .shake{animation:shake .32s ease}
.anim .panel.on{animation:fade .2s ease}
.anim .tabs button,.anim #gear,.anim #clogbtn,.anim .seg button,.anim .btn,.anim .ct{transition:transform .08s ease}
.anim .tabs button:active,.anim #gear:active,.anim #clogbtn:active,.anim .seg button:active,.anim .btn:active{transform:scale(.96)}
.f.im-cpow::after{background-image:url(data:image/png;base64,)}
.f.im-shield::after{background-image:url(data:image/png;base64,)}
.f.im-sword::after{background-image:url(data:image/png;base64,)}
.f.im-dyn::after{background-image:url(data:image/png;base64,)}
.f.im-stat::after{background-image:url(data:image/png;base64,)}
.f.im-fist::after{background-image:url(data:image/png;base64,)}
.f.im-clash::after{background-image:url(data:image/png;base64,)}
#gear,#clogbtn,#mx,#clogx{background:var(--paper);color:var(--ink);border:1px solid var(--line);cursor:pointer;font:inherit}
#gear,#clogbtn{width:38px;height:38px;padding:6px}#gear svg{width:100%;height:100%;fill:currentColor;display:block}
#mx,#clogx{width:30px;height:30px;font-size:1.2rem;line-height:1}
.modal{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:16px}
.modal[hidden]{display:none}
.mc{width:min(440px,100%);max-height:100%;overflow:auto;background:var(--paper);border:1px solid var(--line);border-top:3px solid var(--acc);padding:14px 18px 16px}
.mh{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.mh h2{margin:0;font-size:.85rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 0;border-bottom:1px dashed var(--line)}
.row small{display:block;color:var(--mut);font-size:.7rem}
.seg{display:flex}
.seg button{background:var(--in);color:var(--mut);border:1px solid var(--line);margin-left:-1px;padding:6px 10px;cursor:pointer;font:inherit;font-size:.74rem;letter-spacing:.06em;text-transform:uppercase}
.seg button.on{background:var(--acc);border-color:var(--acc);color:#fff;position:relative}
.ver{color:var(--mut);font-size:.7rem;margin-top:12px;text-align:right}
[data-layout="v"] .layout{grid-template-columns:1fr}
[data-layout="v"] .tabs{display:none}
[data-layout="v"] .panel{display:block;margin-bottom:14px}
[data-layout="v"] .res{position:static}
.f.im-dcrit::after{background-image:url(data:image/png;base64,)}
.f.im-scrit::after{background-image:url(data:image/png;base64,)}
.f.im-stagger::after{background-image:url(data:image/png;base64,)}
.f.im-sinres::after{background-image:url(data:image/png;base64,)}
.f.im-typeres::after{background-image:url(data:image/png;base64,)}
.f.im-typedown::after{background-image:url(data:image/png;base64,)}
.f.im-sindown::after{background-image:url(data:image/png;base64,)}
.f.im-critch::after{background-image:url(data:image/png;base64,)}
#clogbtn i{display:block;width:100%;height:100%;background:currentColor;-webkit-mask:url(data:image/png;base64,) center/contain no-repeat;mask:url(data:image/png;base64,) center/contain no-repeat}
.mc.wide{width:min(560px,100%);display:flex;flex-direction:column;overflow:hidden}
.cbody{overflow:auto;min-height:0;padding:2px 2px 4px}
.ce{border:1px solid var(--line);border-left:4px solid var(--acc);background:var(--in);margin:8px 0}
.ce summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:10px;padding:10px 12px;font-size:.95rem}
.ce summary::-webkit-details-marker{display:none}
.ce summary b{color:var(--gold);letter-spacing:.06em}
.ce summary em{font-style:normal;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;background:var(--acc);color:#fff;padding:2px 6px}
.ce summary::after{content:"\25BC";margin-left:auto;color:var(--acc);font-size:.8rem}
.ce[open] summary::after{transform:rotate(180deg)}
.anim .ce summary::after{transition:transform .15s ease}
.ce .cb{padding:0 14px 12px;border-top:1px dashed var(--line)}
.ce ul{margin:10px 0 0;padding-left:18px}.ce li{margin:4px 0}
.ce .none{color:var(--mut);margin:10px 0 0;font-style:italic}
.f.sm{margin:-2px 0 8px;padding-left:68px}.f.sm>span{font-size:.78rem;color:var(--mut)}.f.sm small{font-size:.66rem}.f.sm input{width:72px;padding:3px 6px;font-size:.8rem}
.seg[hidden]{display:none}
.f.im-weight::after{background-image:url(data:image/png;base64,)}
.hint{color:var(--mut);font-size:.8rem;margin:0 0 10px}
.coin{border:1px solid var(--line);border-left:4px solid var(--gold);background:var(--in);padding:8px 12px;margin:10px 0}
.coin h3{margin:0 0 6px;font-size:1rem;font-weight:800;letter-spacing:.16em;color:var(--acc);text-transform:uppercase}
.cg{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:0 18px}
.btn{background:transparent;border:1px solid var(--acc);color:var(--acc);padding:5px 10px;cursor:pointer;font:inherit;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}
.res{position:sticky;top:10px;background:var(--paper);border:1px solid var(--line);border-top:3px solid var(--gold);padding:14px 16px}
@media(max-width:960px){.res{position:static}}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:12px}
.stat{border:1px solid var(--line);background:var(--in);padding:8px 4px;text-align:center}
.stat b{display:block;font:800 1.3rem/1.1 "Bahnschrift",Arial,sans-serif;color:var(--acc)}
.stat span{font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mut)}
.chart{display:flex;align-items:flex-end;justify-content:center;gap:4px;height:130px;padding:12px 14px 0;background:var(--in);border:1px solid var(--line);border-bottom:2px solid var(--ink)}
.chart div{flex:1 1 0;min-width:3px;max-width:26px;background:linear-gradient(0deg,var(--acc),var(--gold));min-height:1px}.chart div.e{opacity:.3}.chart div.sel{background:var(--ink)}
.axis{padding:0 14px;display:flex;justify-content:space-between;font-size:.7rem;color:var(--mut);margin:3px 0 12px}
.sl{max-height:380px;overflow-y:auto}.sm{font-size:.74rem;color:var(--mut);margin:0 0 8px}.sr{display:grid;grid-template-columns:34px 34px 62px 1fr;align-items:center;gap:8px;padding:6px 8px;margin:4px 0;border:1px solid var(--line);border-left:3px solid var(--gold);background:var(--in);font-size:.78rem}.sr b{font-variant-numeric:tabular-nums}.sr small{color:var(--mut);font-size:.68rem;display:block}.cc{display:flex;gap:4px;align-items:center;font-size:.72rem;color:var(--mut)}
table{border-collapse:collapse;width:100%;font-size:.78rem;font-variant-numeric:tabular-nums}
th{font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);text-align:right;padding:3px 4px;border-bottom:1px solid var(--line)}
td{padding:3px 4px;text-align:right;border-bottom:1px dashed var(--line)}
th:first-child,td:first-child{text-align:left}
.ct{width:34px;height:34px;border-radius:50%;border:2px solid #7a5a10;background:radial-gradient(circle at 35% 30%,#fff1b0,#e2b64d 55%,#a77a14);color:#2a1d04;font-weight:800;cursor:pointer}
.ct.t{background:radial-gradient(circle at 35% 30%,#ddd,#999 60%,#666);border-color:#555;color:#222}
.tot{display:flex;justify-content:space-between;margin-top:10px;font-weight:700}.tot b{color:var(--acc);font-size:1.3rem}
.note{color:var(--mut);font-size:.72rem;margin-top:14px;line-height:1.5}
.note a{color:var(--acc)}
</style>
</head>
<body>
<div class="wrap">
<header><h1>Limbus <b>Damage</b> Calculator</h1><div class="hb"><button id="clogbtn" aria-label="Changelog" title="Changelog"><i></i></button><button id="gear" aria-label="Settings" title="Settings"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19.64 9.64 L22.84 10.14 L22.84 13.86 L19.64 14.36 L19.08 15.73 L20.98 18.35 L18.35 20.98 L15.73 19.08 L14.36 19.64 L13.86 22.84 L10.14 22.84 L9.64 19.64 L8.27 19.08 L5.65 20.98 L3.02 18.35 L4.92 15.73 L4.36 14.36 L1.16 13.86 L1.16 10.14 L4.36 9.64 L4.92 8.27 L3.02 5.65 L5.65 3.02 L8.27 4.92 L9.64 4.36 L10.14 1.16 L13.86 1.16 L14.36 4.36 L15.73 4.92 L18.35 3.02 L20.98 5.65 L19.08 8.27Z M12 8.6a3.4 3.4 0 1 0 0 6.8a3.4 3.4 0 1 0 0-6.8Z"/></svg></button></div></header>
<div class="layout">
<div>
<div class="tabs"><button data-t="skill" class="on">Skill</button><button data-t="coins">Coins</button><button data-t="units">Unit Modifiers</button></div>
<div class="panel on" id="p-skill"><h2>Skill numbers</h2><div id="fs"></div></div>
<div class="panel" id="p-coins"><h2>Per-coin effects</h2><p class="hint">Effects that belong to a single coin.</p><div id="cl"></div></div>
<div class="panel" id="p-units"><div class="two"><div><h2>User</h2><div id="fu"></div></div><div><h2>Target</h2><div id="ft"></div></div></div></div>
</div>
<div class="res"><h2>Damage Preview</h2><div class="seg" id="vseg" hidden style="margin-bottom:10px"><button data-v="main">Main target</button><button data-v="sub">Sub-target</button><button data-v="all">All targets</button></div>
<div class="stats"><div class="stat"><b id="rmin">0</b><span>Minimum</span></div><div class="stat"><b id="ravg">0</b><span>Average</span></div><div class="stat"><b id="rmax">0</b><span>Maximum</span></div><div class="stat"><b id="rsb">0</b><span id="rsp">Sandbox</span></div></div>
<div class="chart" id="chart"></div><div class="axis"><span id="a0">0</span><span id="axl">total damage distribution</span><span id="a1">0</span></div>
<h2>Sandbox: click a coin to flip it</h2><p class="sm" id="sm"></p><div class="sl" id="sb"></div><div class="tot"><span>Sandbox total</span><b id="st">0</b></div>
<p class="note">Formula: <a href="https://limbuscompany.wiki.gg/wiki/Damage_Formula" target="_blank" rel="noopener">Limbus Company Wiki</a> (CC BY-SA 4.0). Coin power stacks per Heads. Heads chance = 50% + SP. Unofficial fan project.</p>
</div>
</div>
</div>
<div class="modal" id="clogmodal" hidden><div class="mc wide" role="dialog" aria-modal="true" aria-label="Changelog"><div class="mh"><h2>Changelog</h2><button id="clogx" aria-label="Close">&times;</button></div><div class="cbody" id="clogbody"></div></div></div>
<div class="modal" id="modal" hidden><div class="mc" role="dialog" aria-modal="true" aria-label="Settings"><div class="mh"><h2>Settings</h2><button id="mx" aria-label="Close">&times;</button></div>
<div class="row"><span>Animations</span><div class="seg" data-k="anim"><button data-v="1">On</button><button data-v="0">Off</button></div></div>
<div class="row"><span>Layout</span><div class="seg" data-k="layout"><button data-v="h">Horizontal</button><button data-v="v">Vertical</button></div></div>
<div class="row"><span>Theme</span><div class="seg" data-k="theme"><button data-v="auto">Auto</button><button data-v="light">Light</button><button data-v="dark">Dark</button></div></div>
<div class="row"><span>Reset all values<small>Back to the base model</small></span><button class="btn" id="reset">Reset all</button></div>
<div class="ver">Limbus Damage Calculator v1.03</div></div></div>
<script>
const $=id=>document.getElementById(id);
// [id,label,default,hint,min,max,integer]
const IMG={aw:'weight',cdyn:'dcrit',sc:'scrit',stg:'stagger',sin:'sinres',dt:'typeres',tdown:'typedown',sdown:'sindown',critp:'critch',fp:'fist',clash:'clash',N:'coin',base:'arm',sp:'brain',cp:'cpow',def:'shield',off:'sword',obonus:'sword',sdyn:'dyn',udyn:'dyn',tdyn:'dyn',sstat:'stat',ustat:'stat',tstat:'stat'};
const F={
fs:[['N','Number of coins',3,'1 to 50',1,50,1],['base','Base power',3,'',0,999],['cp','Coin power',3,'per Heads, stacks. Negative = Minus Coin',-99,999],['off','Offense level',0,'skill total',-99,999],['fp','Skill final power +',0,'',-99,999],['clash','Clash count',0,'+3% static each',0,98,1],['sstat','Skill static damage %',0,'',-100,1000],['sdyn','Skill dynamic damage %',0,'',-100,1000],['aw','Atk Weight',1,'1 to 15 targets',1,15,1],['sub','Damage Against Sub-Targets',0,'0 = same as main target',-100,1000]],
fu:[['obonus','Offense level bonus',0,'',-99,99],['ustat','Static damage %',0,'',-100,1000],['udyn','Dynamic damage %',0,'Damage Up, passives, gifts',-100,1000],['critp','Crit chance %',0,'',0,100],['sc','Static crit bonus %',0,'on top of base 20%',-100,1000],['cdyn','Dynamic crit bonus %',0,'',-100,1000],['sp','Sanity (SP)',0,'-45 to 45',-45,45,1]],
ft:[['def','Defense level',0,'',0,999],['sin','Sin resistance',1,'e.g. 1.5 = Weak',0,10],['dt','Damage-type resistance',1,'',0,10],['sdown','Sin resist down stacks',0,'+0.1 each',0,99,1],['tdown','Type resist down stacks',0,'+0.1 each',0,99,1],['stg','Stagger state','sel'],['tstat','Static damage %',0,'',-100,1000],['tdyn','Dynamic damage %',0,'Fragile, Protection, passives',-100,1000]]};
const CF=[['fp','Final power +/-',0,'',-99,999],['stat','Static %',0,'',-100,1000],['dyn','Dynamic %',0,'',-100,1000],['mult','Multiplier x',1,'',0,100],['flat','Flat damage +',0,'',0,9999,1],['bonus','Bonus % of final dmg',0,'',0,1000]];
const lim={};
Object.values(F).flat().forEach(a=>{if(a[2]!=='sel')lim[a[0]]=[a[2],a[4],a[5],a[6]]});
const clampTo=(v,[d,mn,mx,it])=>{v=parseFloat(v);if(!isFinite(v))v=d;if(it)v=Math.round(v);return Math.min(mx,Math.max(mn,v))};
const nv=id=>clampTo($(id).value,lim[id]);
const attrs=a=>`min="${a[4]}" max="${a[5]}" step="${a[6]?1:'any'}"`;
function build(id){$(id).innerHTML=F[id].map(a=>{const[k,l,v,h]=a;return`<label class="f${IMG[k]?' im im-'+IMG[k]:''}${k==='sub'?' sm':''}"><span>${l}${h&&v!=='sel'?`<small>${h}</small>`:''}</span>`+(v==='sel'?`<select id="${k}"><option value="0">Normal</option><option value="1">Staggered</option><option value="2">Staggered+</option><option value="3">Staggered++</option></select>`:`<input type="number" id="${k}" value="${v}" ${attrs(a)}>`)+`</label>`}).join('')}
['fs','fu','ft'].forEach(build);
const coins=[],cl=(k,v)=>{const a=CF.find(x=>x[0]===k);return clampTo(v,[a[2],a[4],a[5],a[6]])};
let sand=[],lastN=0,shakeIdx=-1,ready=false,view='main';
const bump=e=>{if(!ready||!e)return;e.classList.remove('pop');void e.offsetWidth;e.classList.add('pop')};
const setT=(id,t,box)=>{const e=$(id);if(e.textContent!==t){e.textContent=t;bump(box)}};
const fl=(x,d)=>(Math.floor(x*10**d+1e-9)/10**d).toFixed(d);
const res=x=>x<=0?-.5:x<1?(x-1)/2:x-1;
function P(){const p={};for(const k in lim)p[k]=nv(k);p.stg=parseInt($('stg').value)||0;p.ph=.5+p.sp/100;p.pc=p.critp/100;return p}
// damage of coin i, given number of Heads so far (including this coin) and crit flag
function C(p,i,heads,c,sub){const co=coins[i];
 const roll=Math.max(0,p.base+p.fp+co.fp+p.cp*heads);
 const df=p.off+p.obonus-p.def,lvl=df/(Math.abs(df)+25);
 const dr=res(p.dt+.1*p.tdown),dtM=p.stg>0?Math.max(dr,p.stg*.5+.5):dr;
 const S=res(p.sin+.1*p.sdown)+dtM+lvl+(c?.2+p.sc/100:0)+p.clash*.03+(p.sstat+p.ustat+p.tstat+co.stat)/100;
 const D=(p.sdyn+p.udyn+p.tdyn+co.dyn+(c?p.cdyn:0)+(sub?p.sub:0))/100;
 const d=Math.max(1,Math.floor(Math.max(roll*(1+S)*(1+D)*co.mult,.05*roll)+1e-9));
 const b=co.bonus>0?Math.floor(d*co.bonus/100+1e-9)+Math.floor(co.flat):Math.floor(co.flat);
 return{roll,S:1+S,D:1+D,d,b,t:d+b,lvl,sinM:res(p.sin+.1*p.sdown),dtM}}
function renderCoins(N){while(coins.length<N)coins.push({fp:0,stat:0,dyn:0,mult:1,flat:0,bonus:0});
 $('cl').innerHTML=Array.from({length:N},(_,i)=>`<div class="coin"><h3>Coin ${i+1}</h3><div class="cg">`+CF.map(a=>`<label class="f"><span>${a[1]}</span><input type="number" ${attrs(a)} data-i="${i}" data-k="${a[0]}" value="${coins[i][a[0]]}"></label>`).join('')+`</div></div>`).join('')}
const fmtP=x=>x>=.01?(x*100).toFixed(2)+'%':x>=1e-6?(x*100).toFixed(4)+'%':'<0.0001%';
function analyze(p){const N=p.N,w=[];
 const outs=[[0,0,(1-p.ph)*(1-p.pc)],[0,1,(1-p.ph)*p.pc],[1,0,p.ph*(1-p.pc)],[1,1,p.ph*p.pc]].filter(o=>o[2]>0);
 const T=(i,h,c)=>{const m=C(p,i,h,c).t;if(view==='main')return m;const q=C(p,i,h,c,true).t;return view==='sub'?q:m+(p.aw-1)*q};
 const cache=Array.from({length:N},(_,i)=>Array.from({length:N+1},(_,h)=>[T(i,h,0),T(i,h,1)]));
 // exact average via expectation over Heads count
 let f=Array(N+2).fill(0),g=Array(N+2).fill(0);f[0]=1;
 for(let i=0;i<N;i++){const nf=Array(N+2).fill(0),ng=Array(N+2).fill(0);
  for(let h=0;h<=i;h++)if(f[h]>0||g[h]>0)for(const[hf,c,pr]of outs){const nh=h+hf,d=cache[i][nh][c];nf[nh]+=f[h]*pr;ng[nh]+=(g[h]+f[h]*d)*pr}
  f=nf;g=ng}
 const avg=g.reduce((a,b)=>a+b,0);
 let mn=0,mx=0;const cs=p.pc>0?[0,1]:[0];
 const lo=i=>p.cp>=0?0:i+1,hi=i=>p.cp>=0?i+1:0;
 for(let i=0;i<N;i++){mn+=Math.min(...cs.map(c=>cache[i][lo(i)][c]));mx+=Math.max(...cs.map(c=>cache[i][hi(i)][c]))}
 // distribution: exact DP when small, Monte Carlo otherwise
 let m=new Map([[0,1]]),exact=true;
 for(let i=0;i<N&&exact;i++){const nm=new Map();
  for(const[key,v]of m){const h=key%64,t=(key-h)/64;for(const[hf,c,pr]of outs){const k=(t+cache[i][h+hf][c])*64+h+hf;nm.set(k,(nm.get(k)||0)+v*pr)}}
  m=nm;if(m.size>25000)exact=false}
 const pts=[];
 if(exact){const q=new Map();for(const[key,v]of m){const t=(key-key%64)/64;q.set(t,(q.get(t)||0)+v)}for(const[t,v]of q)pts.push([t,v])}
 else{const S=6000;for(let s=0;s<S;s++){let h=0,t=0;for(let i=0;i<N;i++){const hf=Math.random()<p.ph?1:0,c=Math.random()<p.pc?1:0;h+=hf;t+=cache[i][h][c]}pts.push([t,1/S])}}
 return{avg,mn,mx,pts}}
function render(){const p=P();p.N=Math.round(p.N);if(p.aw<=1)view='main';
 $('vseg').hidden=p.aw<=1;document.querySelectorAll('#vseg button').forEach(b=>b.classList.toggle('on',b.dataset.v===view));$('axl').textContent=view==='main'?'total damage distribution':view==='sub'?'sub-target damage distribution':'all targets damage distribution';if(p.N!==lastN){renderCoins(p.N);lastN=p.N}
 const a=analyze(p);
 setT('rmin',''+a.mn,$('rmin').parentNode);setT('ravg',fl(a.avg,1),$('ravg').parentNode);setT('rmax',''+a.mx,$('rmax').parentNode);$('a0').textContent=a.mn;$('a1').textContent=a.mx;
 while(sand.length<p.N)sand.push({h:1,c:0});sand.length=p.N;
 let tot=0,heads=0,prob=1,rows='',r0=null;
 sand.forEach((s,i)=>{heads+=s.h;const r=C(p,i,heads,s.c),rs=C(p,i,heads,s.c,true);r0=r0||r;tot+=view==='main'?r.t:view==='sub'?rs.t:r.t+(p.aw-1)*rs.t;prob*=(s.h?p.ph:1-p.ph)*(s.c?p.pc:1-p.pc);
  rows+=`<div class="sr"><button class="ct ${s.h?'':'t'}${i===shakeIdx?' shake':''}" onclick="sand[${i}].h^=1;shakeIdx=${i};render()">${s.h?'H':'T'}</button><span><b>C${i+1}</b></span><label class="cc"><input type="checkbox" ${s.c?'checked':''} onchange="sand[${i}].c^=1;render()">Crit</label><div>Power <b>${r.roll}</b> &middot; Dmg <b>${r.d}</b>${r.b?` (+${r.b})`:''}<small>Heads ${heads} &middot; &times;Stat ${fl(r.S,2)} &middot; &times;Dyn ${fl(r.D,2)}${p.aw>1?` &middot; Sub-target ${rs.t}`:''}</small></div></div>`});
 $('sb').innerHTML=rows;setT('st',''+tot,$('st'));{const lab='Sandbox \u00b7 p='+fmtP(prob),ch=$('rsb').textContent!==''+tot||$('rsp').textContent!==lab;$('rsb').textContent=''+tot;$('rsp').textContent=lab;if(ch)bump($('rsb').parentNode)}
 $('sm').textContent=`Level diff ${fl(r0.lvl*100,1)}% \u00b7 Sin res ${fl(r0.sinM*100,0)}% \u00b7 Type res ${fl(r0.dtM*100,0)}%`;
 const B=Math.max(1,Math.min(40,a.mx-a.mn+1)),w=(a.mx-a.mn+1)/B,bins=Array(B).fill(0),idx=t=>Math.max(0,Math.min(B-1,Math.floor((t-a.mn)/w)));
 a.pts.forEach(([t,v])=>bins[idx(t)]+=v);const top=Math.max(...bins,1e-9),sel=idx(tot);
 $('chart').innerHTML=bins.map((b,i)=>`<div class="${i===sel?'sel':''}${b===0?' e':''}" title="${Math.round(a.mn+i*w)}: ${(b*100).toFixed(1)}%" style="height:${Math.max(b/top*100,1)}%"></div>`).join('');shakeIdx=-1;ready=true}
document.addEventListener('input',e=>{const t=e.target;if(t.dataset&&t.dataset.k){coins[+t.dataset.i][t.dataset.k]=cl(t.dataset.k,t.value);render()}else if(t.id&&(lim[t.id]||t.id==='stg'))render()});
document.addEventListener('change',e=>{const t=e.target;if(t.dataset&&t.dataset.k)t.value=coins[+t.dataset.i][t.dataset.k];else if(t.id&&lim[t.id]){t.value=nv(t.id);render()}});
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tabs button,.panel').forEach(x=>x.classList.remove('on'));b.classList.add('on');$('p-'+b.dataset.t).classList.add('on')});
const root=document.documentElement,S={anim:1,layout:'h',theme:'auto'},KEY='limbus-calc-v103';
try{const j=JSON.parse(localStorage.getItem(KEY)||'{}');if(j.anim===0||j.anim===1)S.anim=j.anim;if(j.layout==='v')S.layout='v';if(j.theme==='light'||j.theme==='dark')S.theme=j.theme}catch(e){}
function applySettings(save){
 root.classList.toggle('anim',!!S.anim);root.dataset.layout=S.layout;
 if(S.theme==='auto')delete root.dataset.theme;else root.dataset.theme=S.theme;
 document.querySelectorAll('.seg[data-k]').forEach(g=>g.querySelectorAll('button').forEach(b=>b.classList.toggle('on',String(S[g.dataset.k])===b.dataset.v)));
 if(save)try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
document.querySelectorAll('.seg[data-k] button').forEach(b=>b.onclick=()=>{const k=b.parentNode.dataset.k;S[k]=k==='anim'?+b.dataset.v:b.dataset.v;applySettings(true);if(k==='anim'&&S.anim)bump(b)});
const CHANGELOG=[
 {v:'1.05',n:['Added Atk Weight for the Calculator and Sub-Targets modifiers (like the ones we have in E.G.O Harmony Sinclair)']},
 {v:'1.04',n:['Added the Changelog function.']},
 {v:'1.03',n:null}
];
const NONE='This version\u2019s changelog wasn\u2019t provided.';
const esc=t=>t.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
function renderLog(){
 $('clogbody').innerHTML=CHANGELOG.map((e,i)=>`<details class="ce"${i?'':' open'}><summary><b>Version ${e.v}</b>${i?'':'<em>Current</em>'}</summary><div class="cb">${e.n&&e.n.length?'<ul>'+e.n.map(t=>`<li>${esc(t)}</li>`).join('')+'</ul>':`<p class="none">${NONE}</p>`}</div></details>`).join('');
 document.querySelectorAll('.ver').forEach(v=>v.textContent='Limbus Damage Calculator v'+CHANGELOG[0].v)}
document.querySelectorAll('#vseg button').forEach(b=>b.onclick=()=>{view=b.dataset.v;render()});
renderLog();
const clm=$('clogmodal'),openC=()=>{clm.hidden=false;$('clogx').focus()},closeC=()=>{clm.hidden=true;$('clogbtn').focus()};
$('clogbtn').onclick=openC;$('clogx').onclick=closeC;
clm.addEventListener('click',e=>{if(e.target===clm)closeC()});
